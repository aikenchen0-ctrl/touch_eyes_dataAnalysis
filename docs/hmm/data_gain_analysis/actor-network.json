{
  "artifact": "actor-network",
  "analysisId": "existing-data-limited-gain-20260731",
  "dependsOn": "resource-graph.json",
  "networkPurpose": "trace how touch intent becomes training data, a deployed model, and real-world classification feedback",
  "actors": [
